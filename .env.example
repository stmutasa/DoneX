# DoneX environment variables — copy to .env.local for local dev.
# AI provider keys (OpenAI/Anthropic) and Google OAuth credentials are NOT
# set here: add them from the app's Settings UI after first run — they're
# stored in SQLite, not in the environment.

# Directory holding the SQLite database file (donex.db). On Railway, set to
# /data and mount a Volume there.
DATA_DIR=./data

# Public URL of this deployment, used to build the Google OAuth redirect
# (/api/google/callback) when set; otherwise it's derived from the request.
APP_URL=https://your-app.up.railway.app

# Port the Next.js server listens on.
PORT=3000
