# DoneX environment variables — copy to .env.local for local dev.
# AI provider keys (OpenAI/Anthropic) and Google OAuth credentials are NOT
# set here: add them from the app's Settings UI after first run — they're
# stored in SQLite, not in the environment.
#
# All values below are commented out on purpose: sensible defaults are built
# in (the Docker image already uses DATA_DIR=/data), and hosting dashboards
# that auto-suggest variables from this file would otherwise propose
# local-dev values that are wrong in production.

# Directory holding the SQLite database file (donex.db).
# Local dev default: ./data — no need to set it.
# Railway/Docker: baked into the image as /data (mount your Volume there);
# do NOT set it as a service variable.
#DATA_DIR=./data

# Public URL of this deployment, e.g. https://your-app.up.railway.app —
# used to build the Google OAuth redirect (/api/google/callback) when set;
# otherwise it's derived from the request. Include the https:// scheme.
#APP_URL=

# Port the Next.js server listens on (platforms usually inject this).
#PORT=3000
